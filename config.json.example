{
  "version": 1,
  "settings": {
    "mode": "reframe",
    "targets": {
      "reframe": [
        {
          "ratio": [4, 5],
          "resolution": "source",
          "vcodec": "h265"
        },
        {
          "ratio": [4, 5],
          "resolution": "1080p",
          "vcodec": "h264"
        }
      ],
      "compress": [
        {
          "resolution": "source",
          "vcodec": "h265"
        }
      ]
    },
    "final_ratio": [9, 16],
    "watermarks": {
      "reframe": {
        "enabled": false,
        "file": "",
        "position": "bottom-center",
        "width_ratio": 0.15,
        "margin": 3
      },
      "compress": {
        "enabled": false,
        "file": "",
        "position": "bottom-center",
        "width_ratio": 0.10,
        "margin": 3
      }
    },
    "font_path": "fonts/NotoSerifTC.ttf",
    "font_color": "white",
    "top_font_size": 48,
    "bottom_font_size": 24,
    "text_margin": 20,
    "top_spacing": 1.08,
    "bottom_spacing": 1.2,
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe",
    "workers": 0,
    "skip_existing": true,
    "debug": false
  }
}
